<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <%- include('partials/seo', {"title": "Contact | NODE", "description": "Get in touch with NODE about partnerships, sponsorship, missions or joining the team.", "path": "/contact", "schema": {"@context": "https://schema.org", "@type": "ContactPage", "name": "Contact | NODE", "url": "https://www.nodeengineering.club/contact", "about": {"@id": "https://www.nodeengineering.club/#org"}}}) %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&display=swap" rel="stylesheet">
  <%- themeCSS %>
</head>
<body>

  <%- include('partials/nav') %>

  <section class="page-header">
    <h1>Contact us</h1>
    <p>Partnerships, sponsorship, missions or joining the team: send us a message and we will get back to you.</p>
  </section>

  <section class="contact-page">
    <div class="contact-page-grid">
      <%#
        With WEB3FORMS_KEY set, the form posts to Web3Forms, which emails the
        NODE inbox. Without it, submitting opens the visitor's email app instead.
      %>
      <% if (sent) { %>
        <div class="contact-sent" role="status">
          <h3>Thanks, your message is on its way.</h3>
          <p>We usually reply within a few days.</p>
        </div>
      <% } else { %>
      <form class="contact-form" method="POST" action="https://api.web3forms.com/submit" data-key="<%= formKey ? 'yes' : '' %>">
        <% if (formKey) { %>
          <input type="hidden" name="access_key" value="<%= formKey %>">
          <input type="hidden" name="subject" value="New message from nodeengineering.club">
          <input type="hidden" name="redirect" value="https://www.nodeengineering.club/contact?sent=1">
          <input type="checkbox" name="botcheck" class="visually-hidden" tabindex="-1" autocomplete="off">
        <% } %>
        <label>Name<input type="text" name="name" required autocomplete="name"></label>
        <label>Email<input type="email" name="email" required autocomplete="email"></label>
        <label>Organisation <em>optional</em><input type="text" name="organisation" autocomplete="organization"></label>
        <label>Topic
          <select name="topic">
            <option>Partnership</option>
            <option>Sponsorship</option>
            <option>Missions and research</option>
            <option>Academia</option>
            <option>Joining NODE</option>
            <option>Press</option>
            <option>Something else</option>
          </select>
        </label>
        <label>Message<textarea name="message" rows="6" required></textarea></label>
        <button type="submit">Send message</button>
      </form>
      <% } %>
      <aside class="contact-page-meta">
        <dl>
          <div><dt>Email</dt><dd><a href="mailto:node.engineering.club@gmail.com">node.engineering.club@gmail.com</a></dd></div>
          <div><dt>Where</dt><dd>IAAC Barcelona<br>Carrer de Pujades, 102<br>08005 Barcelona</dd></div>
          <div><dt>Follow</dt><dd><a href="https://www.linkedin.com/company/node-engineering-club/" target="_blank" rel="noopener">LinkedIn</a> · <a href="https://www.instagram.com/node_ec/" target="_blank" rel="noopener">Instagram</a> · <a href="https://github.com/NODE-Engineering-Club" target="_blank" rel="noopener">GitHub</a></dd></div>
        </dl>
      </aside>
    </div>
  </section>

  <script>
    // No form service configured yet: hand the message to the visitor's email app.
    var form = document.querySelector('.contact-form');
    if (form && !form.dataset.key) {
      form.addEventListener('submit', function(e) {
        e.preventDefault();
        var d = new FormData(form);
        var body = d.get('message') + '\n\n' + d.get('name') + (d.get('organisation') ? ', ' + d.get('organisation') : '') + '\n' + d.get('email');
        location.href = 'mailto:node.engineering.club@gmail.com?subject=' + encodeURIComponent(d.get('topic') + ': message from the website') + '&body=' + encodeURIComponent(body);
      });
    }
  </script>

  <%- include('partials/footer', { compact: true }) %>

</body>
</html>
