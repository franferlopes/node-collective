<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <title>Support NODE</title>
  <meta name="description" content="Help NODE build its next autonomous surface vehicle and run more field missions.">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&display=swap" rel="stylesheet">
  <%- themeCSS %>
</head>
<body>

  <%- include('partials/nav') %>

  <section class="page-header">
    <h1>Support NODE</h1>
    <p>Help us build our next autonomous surface vehicle and run more missions.</p>
  </section>

  <section class="support">
    <div class="support-grid">
      <div class="support-text">
        <h3>What your support unlocks</h3>
        <p>
          NODE runs on student time and donated parts. Our next build is a new ASV
          to take on more field missions: more rivers, more ports, more coastline
          monitored. Every contribution, whether it's funding, hardware, or
          expertise, goes directly into getting the next hull in the water.
        </p>
      </div>
      <aside class="support-cta">
        <a class="button" href="mailto:node.engineering.club@gmail.com?subject=Supporting%20NODE">Get in touch</a>
        <p>We're setting up a dedicated funding channel. For now, email us and we'll follow up directly.</p>
      </aside>
    </div>
  </section>

  <%- include('partials/footer') %>

</body>
</html>
