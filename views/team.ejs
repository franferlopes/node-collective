<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <%- include('partials/seo', {"title": "The Team | NODE", "description": "The people behind NODE: students and alumni from IAAC Barcelona building open-source autonomous surface vehicles.", "path": "/team", "schema": {"@context": "https://schema.org", "@type": "AboutPage", "name": "The Team | NODE", "url": "https://www.nodeengineering.club/team", "about": {"@id": "https://www.nodeengineering.club/#org"}}}) %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&display=swap" rel="stylesheet">
  <%- themeCSS %>
</head>
<body>

  <%- include('partials/nav') %>

  <section class="page-header">
    <h1>The Team</h1>
    <p>Architects, designers and engineers from IAAC Barcelona, building autonomous systems together.</p>
  </section>

  <section class="team team-page">
    <div class="team-photo-wrap">
      <img
        src="https://pub-629428d185ca4960a0a73c850d32294b.r2.dev/company_206502/images/fd34036b-094c-4fe4-ba48-042501028240.png"
        alt="NODE Engineering Club, IAAC Barcelona"
      >
    </div>
    <p class="team-caption">NODE Engineering Club, IAAC Barcelona, 2026</p>

    <h2 class="section-label team-members-label">Members</h2>
    <%
      // Add a photo path (e.g. '/images/team/max.jpg') to replace the initials,
      // and a LinkedIn URL to link the name. Titles marked null are still to confirm.
      const members = [
        { name: 'Francisco Ferrer', photo: '/images/team/francisco-ferrer.jpg', title: 'Captain', linkedin: 'https://www.linkedin.com/in/francisco-ferrer-195862152/' },
        { name: 'Maximilian Becht', photo: '/images/team/maximilian-becht.jpg', title: 'Hardware Co-Lead', linkedin: 'https://www.linkedin.com/in/maximilian-becht-61a929207/' },
        { name: 'Lakshmi Narayanan', photo: '/images/team/lakshmi-narayanan.jpg', title: 'Software Lead', linkedin: 'https://www.linkedin.com/in/lakshmi-narayanan-2b9b75177/' },
        { name: 'Belén Comotto', photo: '/images/team/belen-comotto.jpg', title: 'Communications & Strategy Lead', linkedin: 'https://www.linkedin.com/in/belen-comotto-53aaaa197/' },
        { name: 'Salvador Cantuarias', photo: '/images/team/salvador-cantuarias.jpg', title: 'Head of Staff', linkedin: 'https://www.linkedin.com/in/salvador-cantuarias' },
        { name: 'Auxence Daillen', photo: '/images/team/auxence-daillen.jpg', title: 'Hardware Co-Lead', linkedin: 'https://www.linkedin.com/in/auxence-d-32aab7226/' },
        { name: 'Pit Siebenaler', photo: '/images/team/pit-siebenaler.jpg', title: 'Head of Design', linkedin: 'https://www.linkedin.com/in/pit-siebenaler-a45a15218/' },
        { name: 'Saad Khan', title: 'Fabrication', linkedin: 'https://www.linkedin.com/in/saad-khan-7babb7191/' },
      ];
      const founder = { name: 'Marita Georganta', title: 'Founding Mother', linkedin: 'https://www.linkedin.com/in/marita-georganta/' };
    %>
    <% function card(m) { %>
        <li class="member">
          <% if (m.photo) { %>
            <img class="member-photo" src="<%= m.photo %>" alt="<%= m.name %>" loading="lazy">
          <% } else { %>
            <div class="member-photo member-initials" aria-hidden="true"><%= m.name.split(' ').map(function(w) { return w[0]; }).join('').slice(0, 2) %></div>
          <% } %>
          <% if (m.linkedin) { %>
            <a class="crew-link" href="<%= m.linkedin %>" target="_blank" rel="noopener"><strong><%= m.name %></strong></a>
          <% } else { %>
            <strong><%= m.name %></strong>
          <% } %>
          <% if (m.title) { %><span><%= m.title %></span><% } %>
        </li>
    <% } %>
    <ul class="member-grid member-grid-founder">
      <% card(founder); %>
    </ul>
    <ul class="member-grid">
      <% members.forEach(card); %>
    </ul>
  </section>

  <%- include('partials/footer') %>

</body>
</html>
