<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <%- include('partials/seo', {"title": "NODE | Autonomous Systems. Built in the Open.", "description": "NODE is a student and alumni collective at IAAC Barcelona, building autonomous surface vehicles at the intersection of design, engineering, and robotics.", "path": "/", "schema": {"@context": "https://schema.org", "@graph": [{"@type": "Organization", "@id": "https://www.nodeengineering.club/#org", "name": "NODE", "alternateName": ["NODE Engineering Club", "NODE Collective"], "url": "https://www.nodeengineering.club/", "logo": "https://www.nodeengineering.club/images/node-logo.png", "description": "NODE is a student and alumni collective founded at the Institute for Advanced Architecture of Catalonia (IAAC) in Barcelona, building open-source autonomous surface vehicles for marine data collection and environmental monitoring.", "foundingDate": "2024", "founder": {"@type": "Person", "name": "Marita Georganta"}, "parentOrganization": {"@type": "CollegeOrUniversity", "name": "Institute for Advanced Architecture of Catalonia (IAAC)", "url": "https://iaac.net"}, "address": {"@type": "PostalAddress", "addressLocality": "Barcelona", "addressCountry": "ES"}, "email": "node.engineering.club@gmail.com", "sameAs": ["https://www.linkedin.com/company/node-engineering-club/", "https://www.instagram.com/node_ec/", "https://github.com/NODE-Engineering-Club"], "knowsAbout": ["Autonomous surface vehicles", "Marine robotics", "ROS 2", "Environmental monitoring", "Open-source robotics"]}, {"@type": "WebSite", "@id": "https://www.nodeengineering.club/#website", "url": "https://www.nodeengineering.club/", "name": "NODE", "publisher": {"@id": "https://www.nodeengineering.club/#org"}}]}}) %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
