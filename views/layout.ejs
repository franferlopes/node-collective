<%#
  NODE Landing Page — Swiss International Typographic Style
  Sections: Nav, Hero, About, Values, Focus Areas, Partners, Team, Contact/Footer (same order as the nav)
%>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <%- include('partials/seo', {"title": "NODE | Autonomous Systems. Built in the Open.", "description": "NODE is a student and alumni collective at IAAC Barcelona, building autonomous surface vehicles at the intersection of design, engineering, and robotics.", "path": "/", "schema": {"@context": "https://schema.org", "@graph": [{"@type": "Organization", "@id": "https://www.nodeengineering.club/#org", "name": "NODE", "alternateName": ["NODE Engineering Club", "NODE Collective"], "url": "https://www.nodeengineering.club/", "logo": "https://www.nodeengineering.club/images/node-logo.png", "description": "NODE is a student and alumni collective founded at the Institute for Advanced Architecture of Catalonia (IAAC) in Barcelona, building open-source autonomous surface vehicles for marine data collection and environmental monitoring.", "foundingDate": "2024", "founder": {"@type": "Person", "name": "Marita Georganta"}, "parentOrganization": {"@type": "CollegeOrUniversity", "name": "Institute for Advanced Architecture of Catalonia (IAAC)", "url": "https://iaac.net"}, "address": {"@type": "PostalAddress", "addressLocality": "Barcelona", "addressCountry": "ES"}, "email": "node.engineering.club@gmail.com", "sameAs": ["https://www.linkedin.com/company/node-engineering-club/", "https://www.instagram.com/node_ec/", "https://github.com/NODE-Engineering-Club"], "knowsAbout": ["Autonomous surface vehicles", "Marine robotics", "ROS 2", "Environmental monitoring", "Open-source robotics"]}, {"@type": "WebSite", "@id": "https://www.nodeengineering.club/#website", "url": "https://www.nodeengineering.club/", "name": "NODE", "publisher": {"@id": "https://www.nodeengineering.club/#org"}}]}}) %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&display=swap" rel="stylesheet">
  <%- themeCSS %>
</head>
<body>

  <%- include('partials/nav') %>

  <!-- HERO -->
  <section class="hero" id="hero">
    <div class="hero-bg"></div>
    <div class="hero-overlay"></div>
    <div class="hero-content">
      <span class="hero-label">IAAC BCN · Engineering Club · Est. 2024</span>
      <h1><span class="visually-hidden">NODE: </span>Autonomous Systems.<br>Built in the Open.</h1>
      <p>NODE is advancing open research at the intersection of design, engineering, and robotics.</p>
      <div class="hero-actions">
        <a class="btn btn-dark" href="/missions">See our missions</a>
        <a class="btn btn-light" href="/support">Support NODE</a>
      </div>
    </div>
  </section>

  <!-- PROOF BAR -->
  <section class="proof" aria-label="NODE in numbers">
    <dl class="proof-grid">
      <div><dt>2024</dt><dd>Founded at IAAC Barcelona</dd></div>
      <div><dt>2</dt><dd>Njord autonomous ship challenges</dd></div>
      <div><dt>Team Spirit</dt><dd>Award, Njord 2025</dd></div>
      <div><dt>Namibia</dt><dd>First field mission, 2026</dd></div>
    </dl>
  </section>

  <!-- LIVE MISSION (while Namibia runs, 7 Nov to 2 Dec 2026) -->
  <section class="home-live">
    <div class="home-live-inner">
      <div>
        <div class="mission-live-label">Now · Lüderitz, Namibia</div>
        <h2>ASKET is on its first field mission</h2>
        <p>With Kelp Blue, mapping the kelp below the canopy. 7 November to 2 December 2026.</p>
      </div>
      <a class="mission-live-btn" href="/missions/namibia-2026">Follow the mission &rarr;</a>
    </div>
  </section>

  <!-- ABOUT -->
  <section class="about" id="about">
    <h2 class="section-label">About Us</h2>
    <div class="about-grid">
      <div class="about-text">
        <p class="about-lead">We don't just research, we deploy.</p>
        <p>NODE started as a student and alumni collective founded at the Institute for Advanced Architecture of Catalonia (IAAC), building autonomous systems at the intersection of design, engineering, and robotics, rooted in open-source principles and student–industry collaboration.</p>
        <p>In our second year, NODE is advancing its presence in the marine sector, developing Autonomous Surface Vehicles capable of operating in rivers, ports, and coastal environments. We bridge academia and industry through real projects, international competitions, and active partnerships, proving that open research can produce systems that work in the field.</p>
        <p>Our mission is to make intelligent machines accessible across sectors, and our next frontier is autonomous marine data collection and environmental monitoring.</p>
      </div>
      <aside class="about-meta">
        <dl>
          <div>
            <dt>Founded</dt>
            <dd>2024</dd>
          </div>
          <div>
            <dt>Location</dt>
            <dd>IAAC Barcelona</dd>
          </div>
          <div>
            <dt>Sector</dt>
            <dd>Marine Autonomy</dd>
          </div>
          <div>
            <dt>Type</dt>
            <dd>Open-Source Research Collective</dd>
          </div>
        </dl>
      </aside>
    </div>
  </section>

  <!-- VALUES -->
  <section class="values" id="values">
    <h2 class="section-label">Our Values</h2>
    <div class="values-grid">
      <div class="value">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"/></svg>
        <h4>Innovation</h4>
        <p>We push boundaries in autonomy, design and engineering.</p>
      </div>
      <div class="value">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m10.065 12.493-6.18 1.318a.934.934 0 0 1-1.108-.702l-.537-2.15a1.07 1.07 0 0 1 .691-1.265l13.504-4.44"/><path d="m13.56 11.747 4.332-.924"/><path d="m16 21-3.105-6.21"/><path d="M16.485 5.94a2 2 0 0 1 1.455-2.425l1.09-.272a1 1 0 0 1 1.212.727l1.515 6.06a1 1 0 0 1-.727 1.213l-1.09.272a2 2 0 0 1-2.425-1.455z"/><path d="m6.158 8.633 1.114 4.456"/><path d="m8 21 3.105-6.21"/><circle cx="12" cy="13" r="2"/></svg>
        <h4>Curiosity</h4>
        <p>We explore, question and learn something new on every mission.</p>
      </div>
      <div class="value">
        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="16" y="16" width="6" height="6" rx="1"/><rect x="2" y="16" width="6" height="6" rx="1"/><rect x="9" y="2" width="6" height="6" rx="1"/><path d="M5 16v-3a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v3"/><path d="M12 12V8"/></svg>
        <h4>Collaboration</h4>
        <p>We build as a team, across disciplines and borders.</p>
      </div>
      <div class="value">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 3H7a2 2 0 0 0-2 2v5a2 2 0 0 1-2 2 2 2 0 0 1 2 2v5c0 1.1.9 2 2 2h1"/><path d="M16 21h1a2 2 0 0 0 2-2v-5c0-1.1.9-2 2-2a2 2 0 0 1-2-2V5a2 2 0 0 0-2-2h-1"/></svg>
        <h4>Openness</h4>
        <p>We share what we build: code, designs, data and lessons.</p>
      </div>
    </div>
  </section>

  <!-- FOCUS AREAS -->
  <section class="focus" id="focus">
    <h2 class="section-label">Focus Areas</h2>
    <div class="focus-grid">
      <div class="focus-card">
        <div class="focus-card-number">01</div>
        <h3>Marine Autonomy</h3>
        <p>ASV design and deployment for rivers, ports, and coastal environments. We build systems that operate reliably in the field, not just in simulation.</p>
      </div>
      <div class="focus-card">
        <div class="focus-card-number">02</div>
        <h3>Sensor Integration</h3>
        <p>Full data pipeline: sensor selection, onboard processing, and visualization. From raw signal to actionable intelligence, end-to-end.</p>
      </div>
      <div class="focus-card">
        <div class="focus-card-number">03</div>
        <h3>Open Research</h3>
        <p>International competitions, academic partnerships, and open-source systems. We publish our work so others can build on it.</p>
      </div>
    </div>
  </section>

  <!-- PARTNERS -->
  <section class="partners" id="partners">
    <h2 class="section-label">Partners</h2>
    <div class="partners-logos">
      <img src="/images/partners/partner-1.svg" alt="IAAC" loading="lazy">
      <img src="/images/partners/partner-2.svg" alt="LaMaquina" loading="lazy">
      <img src="/images/partners/partner-3.svg" alt="Cerulean Sonars" loading="lazy">
      <img src="/images/partners/partner-4.svg" alt="FabLab IAAC" loading="lazy">
      <img src="/images/partners/partner-5.svg?v=2" alt="Kelp Forest Foundation" loading="lazy">
      <img src="/images/partners/partner-8.png" alt="Kelp Blue" class="logo-stacked" loading="lazy">
      <img src="/images/partners/partner-6.svg" alt="Open Cosmos" loading="lazy">
      <img src="/images/partners/partner-7.svg" alt="Seabots" loading="lazy">
    </div>
  </section>

  <!-- TEAM -->
  <section class="team" id="team">
    <h2 class="section-label">The Team</h2>
    <div class="carousel" data-carousel>
      <div class="carousel-track">
        <figure class="carousel-slide"><img src="https://pub-629428d185ca4960a0a73c850d32294b.r2.dev/company_206502/images/fd34036b-094c-4fe4-ba48-042501028240.png" alt="NODE Engineering Club, IAAC Barcelona" loading="lazy"></figure>
        <figure class="carousel-slide"><img src="/images/missions/njord/njord-team-flag.jpg" alt="The NODE team with their flag at Njord 2026 in Trondheim" loading="lazy"></figure>
        <figure class="carousel-slide"><img src="/images/missions/njord/njord-team-stage.jpg" alt="The NODE team on stage at Njord 2026" loading="lazy"></figure>
        <figure class="carousel-slide"><img src="/images/missions/njord-2025/njord25-team-amore.jpg" alt="NODE and Team AMORE with the boat on the quay in Trondheim, 2025" loading="lazy"></figure>
      </div>
      <button class="carousel-btn carousel-prev" type="button" aria-label="Previous photo">&larr;</button>
      <button class="carousel-btn carousel-next" type="button" aria-label="Next photo">&rarr;</button>
      <div class="carousel-dots"></div>
    </div>
    <p class="team-caption">NODE Engineering Club, IAAC Barcelona, 2026</p>
    <a class="text-link" href="/team">Meet the team &rarr;</a>
  </section>

  <%- include('partials/footer') %>

  <script src="/js/carousel.js"></script>
</body>
</html>
