<%#
  NODE Landing Page — Swiss International Typographic Style
  Sections: Nav, Hero, About, Focus Areas, Team, Contact/Footer
%>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>NODE — Autonomous Systems. Built in the Open.</title>
  <meta name="description" content="NODE is a student and alumni collective at IAAC Barcelona, building autonomous surface vehicles at the intersection of design, engineering, and robotics.">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&display=swap" rel="stylesheet">
  <%- themeCSS %>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --black: #1a1a1a;
      --near-white: #f5f5f3;
      --gray-mid: #888;
      --gray-light: #d8d8d4;
      --gray-xlight: #f0f0ee;
      --teal-dark: #3a7a7a;
      --teal-light: #c8e0e0;
      --white: #ffffff;
    }

    html { scroll-behavior: smooth; }

    body {
      font-family: 'Space Grotesk', -apple-system, BlinkMacSystemFont, sans-serif;
      background: var(--near-white);
      color: var(--black);
      line-height: 1.5;
      -webkit-font-smoothing: antialiased;
    }

    /* ─── NAV ─────────────────────────────────────────── */
    nav {
      position: fixed;
      top: 0; left: 0; right: 0;
      z-index: 100;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 48px;
      height: 64px;
      background: var(--near-white);
      border-bottom: 1px solid var(--gray-light);
    }

    nav .logo-link { display: flex; align-items: center; }
    nav .logo-link svg { height: 32px; width: auto; }

    nav ul {
      list-style: none;
      display: flex;
      gap: 36px;
    }

    nav ul a {
      text-decoration: none;
      color: var(--gray-mid);
      font-size: 0.8125rem;
      font-weight: 500;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      transition: color 0.2s;
    }

    nav ul a:hover { color: var(--black); }

    /* ─── HERO ────────────────────────────────────────── */
    .hero {
      position: relative;
      min-height: 100vh;
      display: flex;
      align-items: flex-end;
      padding: 0 48px 80px;
      overflow: hidden;
    }

    .hero-bg {
      position: absolute;
      inset: 0;
      background: url('/images/landing.png') center center / cover no-repeat;
    }

    .hero-overlay {
      position: absolute;
      inset: 0;
      background: linear-gradient(
        105deg,
        rgba(245,245,243,0.97) 0%,
        rgba(245,245,243,0.75) 45%,
        rgba(245,245,243,0.2) 100%
      );
    }

    .hero-content { position: relative; max-width: 720px; }

    .hero-label {
      display: inline-block;
      font-size: 0.6875rem;
      font-weight: 700;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--gray-mid);
      margin-bottom: 20px;
      border: 1px solid var(--gray-light);
      padding: 5px 10px;
    }

    .hero h1 {
      font-size: clamp(2.5rem, 5.5vw, 4rem);
      font-weight: 700;
      line-height: 1.08;
      letter-spacing: -0.025em;
      margin-bottom: 24px;
      color: var(--black);
    }

    .hero p {
      font-size: 1.0625rem;
      line-height: 1.65;
      color: #444;
      max-width: 560px;
    }

    /* ─── SECTIONS ─────────────────────────────────────── */
    section { padding: 96px 48px; }

    .section-label {
      font-size: 0.6875rem;
      font-weight: 700;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--gray-mid);
      margin-bottom: 48px;
      display: flex;
      align-items: center;
      gap: 16px;
    }

    .section-label::after {
      content: '';
      display: block;
      height: 1px;
      width: 60px;
      background: var(--gray-light);
    }

    /* ─── ABOUT ────────────────────────────────────────── */
    .about { background: var(--white); }

    .about-grid {
      display: grid;
      grid-template-columns: 1fr 280px;
      gap: 80px;
      max-width: 1200px;
    }

    .about-text {
      font-size: 1.0625rem;
      line-height: 1.75;
      color: #333;
    }

    .about-meta {
      border-left: 2px solid var(--black);
      padding-left: 28px;
    }

    .about-meta dl { display: flex; flex-direction: column; gap: 28px; }
    .about-meta dt {
      font-size: 0.6875rem;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--gray-mid);
      margin-bottom: 4px;
    }
    .about-meta dd { font-size: 0.9375rem; font-weight: 500; }

    /* ─── FOCUS AREAS ──────────────────────────────────── */
    .focus { background: var(--gray-xlight); }

    .focus-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 2px;
      max-width: 1200px;
    }

    .focus-card {
      background: var(--white);
      padding: 48px 40px;
      border: 1px solid var(--gray-light);
    }

    .focus-card-number {
      font-size: 0.6875rem;
      font-weight: 700;
      letter-spacing: 0.1em;
      color: var(--gray-mid);
      margin-bottom: 28px;
    }

    .focus-card h3 {
      font-size: 1.25rem;
      font-weight: 700;
      letter-spacing: -0.01em;
      margin-bottom: 16px;
    }

    .focus-card p {
      font-size: 0.9375rem;
      line-height: 1.65;
      color: #555;
    }

    /* ─── TEAM ─────────────────────────────────────────── */
    .team { background: var(--white); }

    .team-photo-wrap {
      max-width: 1200px;
      margin-bottom: 20px;
      overflow: hidden;
    }

    .team-photo-wrap img {
      width: 100%;
      height: auto;
      display: block;
      object-fit: cover;
    }

    .team-caption {
      font-size: 0.8125rem;
      color: var(--gray-mid);
      letter-spacing: 0.04em;
    }

    /* ─── PARTNERS ─────────────────────────────────────── */
    .partners { background: var(--gray-xlight); }

    .partners-logos {
      display: flex;
      align-items: center;
      justify-content: center;
      flex-wrap: wrap;
      gap: 48px 64px;
      max-width: 1200px;
    }

    .partners-logos img {
      height: 32px;
      width: auto;
      max-width: 160px;
      object-fit: contain;
      opacity: 1;
    }

    /* ─── CONTACT ───────────────────────────────────────── */
    .contact {
      background: var(--black);
      color: var(--near-white);
    }

    .contact .section-label { color: #666; }
    .contact .section-label::after { background: #333; }

    .contact-heading {
      font-size: clamp(2rem, 4vw, 3.25rem);
      font-weight: 700;
      letter-spacing: -0.03em;
      margin-bottom: 56px;
      line-height: 1.1;
    }

    .contact-bottom {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 48px;
      border-top: 1px solid #2a2a2a;
      padding-top: 48px;
    }

    .contact-logo svg { height: 48px; width: auto; opacity: 0.6; }

    .contact-info { text-align: right; }

    .contact-info p {
      font-size: 0.875rem;
      color: #888;
      line-height: 1.8;
    }

    .contact-info a {
      color: var(--near-white);
      text-decoration: none;
      transition: opacity 0.2s;
    }

    .contact-info a:hover { opacity: 0.7; }

    /* ─── MOBILE ───────────────────────────────────────── */
    @media (max-width: 768px) {
      nav { padding: 0 24px; }
      nav ul { gap: 20px; }

      section { padding: 72px 24px; }

      .hero { padding: 0 24px 64px; min-height: 85vh; }
      .hero h1 { font-size: 2.25rem; }

      .about-grid {
        grid-template-columns: 1fr;
        gap: 48px;
      }
      .about-meta { border-left: none; border-top: 2px solid var(--black); padding-left: 0; padding-top: 28px; }
      .about-meta dl { flex-direction: row; flex-wrap: wrap; gap: 16px 32px; }

      .focus-grid { grid-template-columns: 1fr; gap: 2px; }

      .contact-bottom { flex-direction: column; }
      .contact-info { text-align: left; }
    }
  </style>
</head>
<body>

