<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <title><%= post.title %> | NODE</title>
  <meta name="description" content="<%= post.excerpt %>">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&display=swap" rel="stylesheet">
  <%- themeCSS %>
</head>
<body>

  <%- include('../partials/nav') %>

  <section class="about" style="padding-top: 160px;">
    <div class="mission-detail">
      <a class="back-link" href="/missions">&larr; All missions</a>
      <div class="mission-category"><%= post.category %></div>
      <h1><%= post.title %></h1>
      <div class="mission-date"><%= post.publishedAtFormatted %></div>
      <% if (post.cover_image_url) { %>
        <img class="cover" src="<%= post.cover_image_url %>" alt="">
      <% } %>
      <div class="mission-body"><%= post.body %></div>
    </div>
  </section>

  <%- include('../partials/footer') %>

</body>
</html>
