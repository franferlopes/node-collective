<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <title>Missions | NODE</title>
  <meta name="description" content="Mission updates, press, and news from NODE, an autonomous surface vehicle collective at IAAC Barcelona.">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&display=swap" rel="stylesheet">
  <%- themeCSS %>
</head>
<body>

  <%- include('../partials/nav') %>

  <section class="page-header">
    <h1>Missions</h1>
    <p>Updates from the field: deployments, competitions, and partnerships.</p>
  </section>

  <section class="missions">
    <div class="mission-featured-row">
      <a class="mission-featured" href="/missions/namibia-2026">
        <div class="mission-category">Mission · Now</div>
        <h3>Namibia 2026: the kelp below the canopy</h3>
        <p>ASKET in Lüderitz with Kelp Blue, 7 November to 2 December 2026.</p>
      </a>
      <a class="mission-featured has-image" href="/missions/njord-2026">
        <img class="mission-featured-img" src="/images/missions/njord/njord-teams.jpg" alt="All Njord 2026 teams with their boats and flags in front of the Haven building in Trondheim" loading="lazy">
        <div class="mission-category">Competition</div>
        <h3>Njord 2026: ASKET 2.0 in Trondheim</h3>
        <p>The autonomous ship challenge at NTNU, August 2026. Five places up on 2025.</p>
      </a>
    </div>
    <% if (posts.length === 0) { %>
    <% } else { %>
      <div class="focus-grid">
        <% posts.forEach(function(post) { %>
          <a class="focus-card" href="/missions/<%= post.slug %>">
            <div class="mission-category"><%= post.category %></div>
            <h3><%= post.title %></h3>
            <p><%= post.excerpt %></p>
            <div class="mission-date"><%= post.publishedAtFormatted %></div>
          </a>
        <% }); %>
      </div>
    <% } %>
  </section>

  <%- include('../partials/footer') %>

</body>
</html>
