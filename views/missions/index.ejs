<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <%- include('../partials/seo', {"title": "Missions | NODE", "description": "Mission updates, press, and news from NODE, an autonomous surface vehicle collective at IAAC Barcelona.", "path": "/missions", "schema": {"@context": "https://schema.org", "@type": "CollectionPage", "name": "Missions | NODE", "url": "https://www.nodeengineering.club/missions", "about": {"@id": "https://www.nodeengineering.club/#org"}}}) %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&display=swap" rel="stylesheet">
  <%- themeCSS %>
</head>
<body>

  <%- include('../partials/nav') %>

  <section class="page-header">
    <h1>Missions</h1>
    <p>Updates from the field: deployments, competitions, and events.</p>
  </section>

  <section class="missions">
    <h2 class="section-label">Missions and competitions</h2>
    <div class="mission-featured-row">
      <a class="mission-featured" href="/missions/namibia-2026">
        <div class="mission-category">Mission · Now</div>
        <h3>Namibia 2026: the kelp below the canopy</h3>
        <p>ASKET in Lüderitz with Kelp Blue, 7 November to 2 December 2026.</p>
      </a>
      <a class="mission-featured has-image" href="/missions/njord-2026">
        <img class="mission-featured-img" src="/images/missions/njord/njord-teams.jpg" alt="All Njord 2026 teams with their boats and flags in front of the Haven building in Trondheim" loading="lazy">
        <div class="mission-category">Competition</div>
        <h3>Njord 2026: ASKET 2.0 in Trondheim</h3>
        <p>The autonomous ship challenge at NTNU, August 2026. Five places up on 2025.</p>
      </a>
      <a class="mission-featured has-image" href="/missions/njord-2025">
        <img class="mission-featured-img" src="/images/missions/njord-2025/njord25-team-amore.jpg" alt="NODE and Team AMORE with the boat on the quay in Trondheim" loading="lazy">
        <div class="mission-category">Competition</div>
        <h3>Njord 2025: our first edition</h3>
        <p>Trondheim, August 2025. A partnership with Team AMORE and the Team Spirit Award.</p>
      </a>
    </div>
    <%# Events: date, place, photos and pages to come from the team. %>
    <h2 class="section-label">Events</h2>
    <div class="mission-featured-row">
      <div class="mission-featured is-pending">
        <div class="mission-category">Event · Organised by NODE</div>
        <h3>Marine Tech Forum</h3>
        <p>The forum NODE organised, bringing together people working on marine technology.</p>
        <span class="mission-soon">Recap coming soon</span>
      </div>
      <div class="mission-featured is-pending">
        <div class="mission-category">Event · 2027</div>
        <h3>Our next event</h3>
        <p>Something new is on the way for 2027. Details soon.</p>
        <span class="mission-soon">Announcement coming soon</span>
      </div>
    </div>
    <% if (posts.length === 0) { %>
    <% } else { %>
      <div class="focus-grid">
        <% posts.forEach(function(post) { %>
          <a class="focus-card" href="/missions/<%= post.slug %>">
            <div class="mission-category"><%= post.category %></div>
            <h3><%= post.title %></h3>
            <p><%= post.excerpt %></p>
            <div class="mission-date"><%= post.publishedAtFormatted %></div>
          </a>
        <% }); %>
      </div>
    <% } %>
  </section>

  <%- include('../partials/footer') %>

</body>
</html>
